# Copy this to terraform.tfvars and fill in — terraform.tfvars is
# gitignored so it never gets committed.
#
# The db_password is intentionally NOT set here. Set it as an
# environment variable instead, so it never touches disk in this repo:
#
#   export TF_VAR_db_password="something-long-and-random"
#
# On Windows (PowerShell):
#   $env:TF_VAR_db_password = "something-long-and-random"

aws_region   = "us-east-1"
environment  = "dev"
cluster_name = "fernway-dev"
