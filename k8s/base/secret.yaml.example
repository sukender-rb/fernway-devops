# DO NOT fill this in and commit it. This file documents the shape of
# the secret the backend expects; create the real one with a command
# like the one below (values come from Terraform's rds_endpoint output):
#
#   kubectl create secret generic fernway-db-secret \
#     --namespace fernway \
#     --from-literal=DATABASE_URL="postgresql://fernway_user:<password>@<rds_endpoint>/fernway"
#
# For a real production setup, use AWS Secrets Manager + the External
# Secrets Operator instead of kubectl-created secrets — that way nothing
# sensitive ever sits in your shell history or a YAML file at all.

apiVersion: v1
kind: Secret
metadata:
  name: fernway-db-secret
  namespace: fernway
type: Opaque
stringData:
  DATABASE_URL: "postgresql://REPLACE_ME"
