// Multibranch pipeline. Jenkins runs this same file for whichever branch
// triggered it (dev/staging/main) — the "Determine environment" stage is
// what makes each branch deploy somewhere different.

pipeline {
  agent any

  environment {
    AWS_REGION     = 'eu-west-1'
    AWS_ACCOUNT_ID = credentials('aws-account-id') // Jenkins "Secret text" credential
    IMAGE_TAG      = "${env.GIT_COMMIT.take(7)}"
  }

  stages {

    stage('Determine environment') {
      steps {
        script {
          // main -> prod, staging -> staging, everything else -> dev.
          // Adjust cluster/namespace names to match what Terraform
          // actually created for each environment.
          if (env.BRANCH_NAME == 'main') {
            env.DEPLOY_ENV     = 'prod'
            env.OVERLAY_PATH   = 'k8s/overlays/prod'
          } else if (env.BRANCH_NAME == 'staging') {
            env.DEPLOY_ENV     = 'staging'
            env.OVERLAY_PATH   = 'k8s/overlays/staging'
          } else {
            env.DEPLOY_ENV     = 'dev'
            env.OVERLAY_PATH   = 'k8s/overlays/dev'
          }

          // Without this, the GitOps commit Jenkins makes later in this
          // pipeline would itself trigger a new build via the GitHub
          // webhook — which commits again — forever. Skip any build that
          // was triggered by Jenkins' own commit.
          def lastCommitMsg = sh(script: 'git log -1 --pretty=%B', returnStdout: true).trim()
          if (lastCommitMsg.contains('[skip ci]')) {
            env.SKIP_BUILD = 'true'
            echo "Skipping — this commit was made by the pipeline itself: ${lastCommitMsg}"
          } else {
            env.SKIP_BUILD = 'false'
            echo "Branch ${env.BRANCH_NAME} -> deploying to ${env.DEPLOY_ENV}"
          }
        }
      }
    }

    stage('Backend: install & test') {
      when { expression { env.SKIP_BUILD != 'true' } }
      steps {
        dir('backend') {
          sh 'npm ci'
          sh 'npm test'
        }
      }
    }

    stage('Frontend: install & build') {
      when { expression { env.SKIP_BUILD != 'true' } }
      steps {
        dir('frontend') {
          sh 'npm ci'
          sh 'npm run build'
        }
      }
    }

    stage('Code quality (SonarQube)') {
      when { expression { env.SKIP_BUILD != 'true' } }
      steps {
        // 'SonarQube' here must match the server name configured in
        // Manage Jenkins -> System -> SonarQube servers (see jenkins/README.md).
        withSonarQubeEnv('SonarQube') {
          sh 'sonar-scanner'
        }
      }
    }

    stage('Quality gate') {
      when { expression { env.SKIP_BUILD != 'true' } }
      steps {
        // Blocks here and fails the build if SonarQube's quality gate
        // fails — this only works once SonarQube is configured to call
        // back to Jenkins via a webhook (also in jenkins/README.md).
        timeout(time: 5, unit: 'MINUTES') {
          waitForQualityGate abortPipeline: true
        }
      }
    }

    stage('Build Docker images') {
      when { expression { env.SKIP_BUILD != 'true' } }
      steps {
        sh "docker build -t fernway-backend:${IMAGE_TAG} ./backend"
        sh "docker build -t fernway-frontend:${IMAGE_TAG} ./frontend"
      }
    }

    stage('Security scan (Trivy)') {
      when { expression { env.SKIP_BUILD != 'true' } }
      steps {
        // Fails the build on HIGH/CRITICAL CVEs instead of silently
        // shipping a vulnerable image — this is the actual enforcement
        // point, not just a report nobody reads.
        sh "trivy image --exit-code 1 --severity HIGH,CRITICAL --no-progress fernway-backend:${IMAGE_TAG}"
        sh "trivy image --exit-code 1 --severity HIGH,CRITICAL --no-progress fernway-frontend:${IMAGE_TAG}"
      }
    }

    stage('Push to ECR') {
      when { expression { env.SKIP_BUILD != 'true' } }
      steps {
        withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials']]) {
          sh '''
            aws ecr get-login-password --region $AWS_REGION | \
              docker login --username AWS --password-stdin $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com

            docker tag fernway-backend:${IMAGE_TAG} $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/fernway-backend:${IMAGE_TAG}
            docker tag fernway-frontend:${IMAGE_TAG} $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/fernway-frontend:${IMAGE_TAG}

            docker push $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/fernway-backend:${IMAGE_TAG}
            docker push $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/fernway-frontend:${IMAGE_TAG}
          '''
        }
      }
    }

    stage('Update GitOps manifest') {
      when { expression { env.SKIP_BUILD != 'true' } }
      steps {
        // This is the actual "deploy" now — Jenkins never touches the
        // cluster. It updates the image tag in the environment's overlay
        // and pushes that to Git. ArgoCD (running in-cluster, watching
        // this repo) picks up the commit and syncs the cluster itself.
        withCredentials([
          usernamePassword(credentialsId: 'github-credentials', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_TOKEN')
        ]) {
          sh '''
            cd $OVERLAY_PATH
            kustomize edit set image fernway-backend=$AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/fernway-backend:${IMAGE_TAG}
            kustomize edit set image fernway-frontend=$AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/fernway-frontend:${IMAGE_TAG}
            cd -

            git config user.email "jenkins-ci@fernway.local"
            git config user.name "jenkins-ci"
            git add $OVERLAY_PATH/kustomization.yaml
            git commit -m "ci: deploy ${IMAGE_TAG} to ${DEPLOY_ENV} [skip ci]" || echo "Nothing changed, skipping commit"
            git push "https://${GIT_USER}:${GIT_TOKEN}@github.com/https://github.com/sukender-rb/fernway-devops.git" HEAD:${BRANCH_NAME}
          '''
        }
      }
    }
  }

  post {
    success {
      echo "Deployed ${IMAGE_TAG} to ${env.DEPLOY_ENV}"
    }
    failure {
      // Wire this to Slack/email once you have a webhook — this is the
      // exact point a real incident alert fires from.
      echo "Pipeline failed on branch ${env.BRANCH_NAME} — deploy to ${env.DEPLOY_ENV} did NOT happen."
    }
  }
}
